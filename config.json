{
  "schema_version": 2,
  "typesense": {
    "primary_url": "https://ts-lb.nd-api.com/multi_search",
    "fallback_urls": [
      "https://etmzpxgvnid370fyp.a1.typesense.net/multi_search"
    ],
    "public_search_key": "STHKtT6jrC5z1IozTJHIeSN4qN9oL1s3",
    "collection": "public_characters_alias",
    "query_by": "name,title,tags,creator_username,character_id,type",
    "application_filter": "application_ids:=spicychat && type:!=META && visibility:=public"
  },
  "character_api": {
    "base_url": "https://prod.nd-api.com/v2/characters/",
    "country": "US"
  },
  "crawler": {
    "listing_page_size": 250,
    "listing_max_hits": 2500,
    "explore_pages_per_run": 20,
    "enrichment_budget": 200,
    "image_budget": 100,
    "image_archive_enabled": true,
    "missing_verification_budget": 100,
    "deleted_confirmations_required": 2,
    "request_timeout_seconds": 20,
    "request_delay_ms": 80
  },
  "storage": {
    "mode": "auto",
    "r2": {
      "bucket": "spicychat-archive",
      "public_base_url": "https://data.spicychatarchive.drache.uk",
      "bot_prefix": "bots",
      "media_prefix": "media",
      "rankings_prefix": "rankings",
      "meta_prefix": "_meta",
      "cache_seconds": 300,
      "memory_cache_records": 25000,
      "bloom_bytes": 8388608,
      "bloom_hashes": 7
    }
  },
  "listings": {
    "trending": "_text_match(buckets: 3):desc,num_messages_24h:desc",
    "top-rated": "rating_score:desc,num_messages:desc",
    "popular": "num_messages:desc",
    "latest": "createdAt:desc"
  }
}
